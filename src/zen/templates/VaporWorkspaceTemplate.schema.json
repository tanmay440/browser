{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vapor.local/schemas/workspace-template-1.0.json",
  "title": "Vapor Workspace Template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "name", "description", "icon", "color", "pinned_tabs",
    "default_new_tab_type", "default_new_tab_url", "default_search_engine",
    "script_blocking_default", "adblocker_enabled", "url_stripping_enabled",
    "cname_uncloaking_enabled", "auto_launch_vpn",
    "tab_hibernation_timeout_minutes", "homepage", "remembered_sites",
    "remembered_sites_scope"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "minLength": 1 },
    "pinned_tabs": { "type": "array", "items": { "type": "string" } },
    "default_new_tab_type": { "enum": ["regular", "tor", "scramjet"] },
    "default_new_tab_url": { "type": "string" },
    "default_search_engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "search_url", "suggest_url"],
      "properties": {
        "name": { "type": "string" },
        "search_url": { "type": "string" },
        "suggest_url": { "type": "string" }
      }
    },
    "script_blocking_default": { "enum": ["allow-all", "first-party-only", "block-all"] },
    "adblocker_enabled": { "type": "boolean" },
    "url_stripping_enabled": { "type": "boolean" },
    "cname_uncloaking_enabled": { "type": "boolean" },
    "auto_launch_vpn": { "type": "boolean" },
    "tab_hibernation_timeout_minutes": { "type": "number", "minimum": 0 },
    "homepage": { "type": "string" },
    "remembered_sites": { "type": "array", "items": { "type": "string" } },
    "remembered_sites_scope": { "enum": ["global", "workspace"] }
  }
}
