# The package declaration is included from browser.jar's manifest. It gives
# Round 2's blank responses the requested chrome://vapor/content/ URLs.
% content vapor %content/vapor/ contentaccessible=yes
        content/vapor/blank.png                                             (../../zen/shield/blank.png)
        content/vapor/blank.js                                              (../../zen/shield/blank.js)
        content/vapor/blank.css                                             (../../zen/shield/blank.css)
        content/vapor/blank.html                                            (../../zen/shield/blank.html)
        content/vapor/default.txt                                            (../../zen/shield/default.txt)
#include ../filter/jar.inc.mn
#include ../privacy/jar.inc.mn
